# Let Git detect text and normalize it to LF.
* text=auto eol=lf

*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Common binary assets are binary; do not force unknown files to text.
*.epub binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.mov binary
*.mp3 binary
*.mp4 binary
*.pdf binary
*.png binary
*.webp binary
*.zip binary
