{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "手不释卷",
  "version": "../package.json",
  "identifier": "com.gripread.reader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "手不释卷 · GripRead",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwNTlFOTFDQ0Y2REIwRkQKUldUOXNHM1BIT2xaNE05TTJrdnJrbG95SmdyemFqb1VJbjNmbWdLcGdNRmR5a3BrN0pTWjBPbkwK"
    }
  }
}
