{
  "name": "gripread",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:docs": "node --test scripts/check-docs.test.mjs",
    "generate:types": "cargo run --manifest-path src-tauri/Cargo.toml --bin generate-types",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:native": "node scripts/native-test.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:generated-types": "cargo run --manifest-path src-tauri/Cargo.toml --bin generate-types -- --check",
    "check": "pnpm format:check && pnpm check:docs && pnpm test:docs && pnpm check:generated-types && pnpm check:boundaries && pnpm test:boundaries && pnpm typecheck && pnpm typecheck:native && pnpm test && pnpm test:rust && pnpm check:rust && pnpm build",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"tests/**/*.ts\" \"*.{json,ts,js,html}\"",
    "test:boundaries": "node --test scripts/check-boundaries.test.mjs",
    "typecheck:native": "tsc --noEmit -p tsconfig.native.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "motion": "^12.23.24",
    "page-flip": "^2.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "@wdio/types": "^9.30.1",
    "autoprefixer": "^10.6.1",
    "expect-webdriverio": "5.6.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.7",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "webdriverio": "9.30.1"
  }
}
