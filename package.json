{
  "name": "gripread",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:docs": "node --test scripts/check-docs.test.mjs",
    "generate:types": "cargo run --manifest-path src-tauri/Cargo.toml --bin generate-types",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:native": "node scripts/native-smoke.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:generated-types": "cargo run --manifest-path src-tauri/Cargo.toml --bin generate-types -- --check",
    "check": "pnpm check:docs && pnpm test:docs && pnpm check:generated-types && pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm test:rust && pnpm check:rust && pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "motion": "^12.23.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/node": "^24.3.0",
    "@tauri-apps/cli": "^2.11.1",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
